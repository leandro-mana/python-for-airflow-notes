# Airflow Docker Compose environment variables
# Copy this file to .env before running: cp .env.example .env

AIRFLOW_UID=501
AIRFLOW_GID=0

# Airflow image (override to use a custom image)
# AIRFLOW_IMAGE_NAME=apache/airflow:2.10.4

# Admin credentials (default: airflow/airflow)
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
